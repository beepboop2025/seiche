[Unit]
Description=Seiche cross-desk tandem check (plumbing x institutions)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seiche-bot
Group=seiche-bot
UMask=0077
WorkingDirectory=/opt/seiche-bot
EnvironmentFile=/etc/seiche-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=seiche-bot
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/seiche-bot/seiche_bot.py --tandem

ReadWritePaths=/var/lib/seiche-bot
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
