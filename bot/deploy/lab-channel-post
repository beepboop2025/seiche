#!/usr/bin/env python3
"""lab-channel-post: publish ONE message to the free Liquidity Lab channel.

Built for the Hermes rissaga-desk-reads lane. The bot token is read by THIS
script (from the gateway's own .env), never passed via argv or a URL: the
fleet already paid for that lesson when a logged sendMessage URL leaked a
token. Message text arrives via --text-file PATH or stdin (HTML). The
standard Rissaga footer and the stranger-facing keyboard (three core desks
plus Share, ref lab_rissaga) are appended here so the caller cannot get
them wrong. The eight-desk dump stays on OPERATOR_KEYBOARD for operators.

Exit 0 with {"ok": true, "message_id": N} on stdout, nonzero otherwise.
"""

import html
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ENV_FILE = os.environ.get("LAB_POST_ENV", "/home/hermes/.hermes/.env")
CHANNEL = os.environ.get("LAB_CHANNEL_ID", "-1004297805949")
REF = "lab_rissaga"
CHANNEL_LINK = "https://t.me/LiquidityLabDesk"
FOOT = ("\n\n<i>Public data, timestamped. Research and market context only, "
        "not advice or an execution instruction.</i>")
DESK_BOTS = {
    "SEICHE": ("Seiche", "https://t.me/seiche_desk_bot"),
    "LIQUILENS": ("LiquiLens", "https://t.me/LiquiLens_bot"),
    "UNDERTOW": ("Undertow", "https://t.me/undertow_LiquiLens_bot"),
    "RIPTIDE": ("Riptide", "https://t.me/riptide_anake_bot"),
    "PALIMPSEST": ("Palimpsest", "https://t.me/palimpsest_watch_bot"),
    "CORPORATE": ("Corporate Stress", "https://t.me/corporate_stress_bot"),
    "REALECON": ("Real Economy", "https://t.me/real_economy_desk_bot"),
    "CRYPTO": ("Crypto", "https://t.me/liquilens_crypto_bot"),
}
TAG_RE = re.compile(r"<[^>]+>")
SHARE_URL = "https://t.me/share/url?" + urllib.parse.urlencode({
    "url": CHANNEL_LINK,
    "text": ("Public US dollar-funding board. One daily letter, "
             "state-change alerts. Research only."),
})
# First-time readers of @LiquidityLabDesk see the three live FI desks.
# Palimpsest, Riptide, corporate, real-econ and crypto stay off this row.
KEYBOARD = [
    [{"text": "\U0001f30a Seiche",
      "url": f"https://t.me/seiche_desk_bot?start={REF}"}],
    [{"text": "\U0001f3e6 LiquiLens",
      "url": f"https://t.me/LiquiLens_bot?start={REF}"},
     {"text": "\U0001f300 Undertow",
      "url": f"https://t.me/undertow_LiquiLens_bot?start={REF}"}],
    [{"text": "\U0001f4e4 Share", "url": SHARE_URL}],
]
# Operator dump of the eight routed desks. Not the public default.
OPERATOR_KEYBOARD = [
    [{"text": "\U0001f321 Plumbing desk",
      "url": f"https://t.me/seiche_desk_bot?start={REF}"}],
    [{"text": "\U0001f3e6 Failure radar",
      "url": f"https://t.me/LiquiLens_bot?start={REF}"},
     {"text": "\U0001f300 Market depth",
      "url": f"https://t.me/undertow_LiquiLens_bot?start={REF}"}],
    [{"text": "\U0001f9ed Riptide risk desk",
      "url": f"https://t.me/riptide_anake_bot?start={REF}"},
     {"text": "\U0001f9f1 Palimpsest watch",
      "url": f"https://t.me/palimpsest_watch_bot?start={REF}"}],
    [{"text": "\U0001f3ed Corporate stress",
      "url": f"https://t.me/corporate_stress_bot?start={REF}"},
     {"text": "\U0001f6d2 Real economy",
      "url": f"https://t.me/real_economy_desk_bot?start={REF}"}],
    [{"text": "\U0001f4a7 Crypto rails and regime",
      "url": f"https://t.me/liquilens_crypto_bot?start={REF}"}],
]


def contextual_keyboard(text: str) -> list:
    """Offer one relevant desk action instead of eight competing choices."""
    match = re.search(r"\[([A-Z]+)\s*\u00b7", text)
    desk = match.group(1) if match else ""
    if desk not in DESK_BOTS:
        return KEYBOARD
    label, bot_link = DESK_BOTS[desk]
    ref = f"lab_rissaga_{desk.lower()}"
    share = "https://t.me/share/url?" + urllib.parse.urlencode({
        "url": CHANNEL_LINK,
        "text": "A sourced Liquidity Lab desk read with a live check and falsifier.",
    })
    return [[
        {"text": f"Open + follow {label}", "url": f"{bot_link}?start={ref}"},
        {"text": "Share Liquidity Lab", "url": share},
    ]]


def message_with_footer(text: str) -> str:
    message = text + FOOT
    if len(message.encode("utf-16-le")) // 2 > 4096:
        raise ValueError("message exceeds Telegram limit")
    return message


def plain_text(value: str) -> str:
    return html.unescape(TAG_RE.sub("", value))


def _token() -> str:
    tok = os.environ.get("TELEGRAM_BOT_TOKEN", "")
    if not tok:
        try:
            with open(ENV_FILE, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith("TELEGRAM_BOT_TOKEN="):
                        tok = line.split("=", 1)[1].strip().strip('"').strip("'")
                        break
        except OSError:
            pass
    if not tok:
        print("no bot token available", file=sys.stderr)
        sys.exit(2)
    return tok


def _post(payload: dict) -> dict:
    req = urllib.request.Request(
        f"https://api.telegram.org/bot{_token()}/sendMessage",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as exc:
        try:
            return json.load(exc)
        except Exception:
            return {"ok": False, "error_code": exc.code}
    except Exception as exc:                                  # noqa: BLE001
        return {"ok": False, "description": type(exc).__name__}


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "--text-file":
        with open(sys.argv[2], encoding="utf-8") as fh:
            text = fh.read().strip()
    else:
        text = sys.stdin.read().strip()
    if not text:
        print("empty text", file=sys.stderr)
        return 2
    try:
        message = message_with_footer(text)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    payload = {"chat_id": int(CHANNEL), "text": message,
               "parse_mode": "HTML", "disable_web_page_preview": True,
               "reply_markup": {"inline_keyboard": contextual_keyboard(text)}}
    res = _post(payload)
    if not res.get("ok") and res.get("error_code") == 429:
        wait = (res.get("parameters") or {}).get("retry_after") or 3
        time.sleep(min(float(wait), 30.0))
        res = _post(payload)
    if not res.get("ok") and res.get("error_code") == 400:
        plain = {k: v for k, v in payload.items() if k != "parse_mode"}
        plain["text"] = plain_text(message)
        res = _post(plain)
    if res.get("ok"):
        print(json.dumps({"ok": True,
                          "message_id": res["result"]["message_id"]}))
        return 0
    print(json.dumps({"ok": False,
                      "error": res.get("description") or res.get("error_code")}),
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
