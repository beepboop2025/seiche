[Unit]
Description=Seiche canonical official-data backfill
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=seiche
Group=seiche
WorkingDirectory=/home/seiche/app
EnvironmentFile=/etc/seiche/market.env
EnvironmentFile=-/etc/seiche/rbnz-access.env
EnvironmentFile=-/etc/seiche/bok-ecos.env
ExecStart=/home/seiche/app/backend/.venv/bin/seiche market-backfill
TimeoutStartSec=2h
# Backfill is throughput work, not request-path work. Keep one CPU available to
# it while giving the API and deploy health probes priority under contention.
CPUQuota=100%
CPUWeight=10
IOWeight=10
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/seiche
UMask=0027
