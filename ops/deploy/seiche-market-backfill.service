[Unit]
Description=Seiche canonical official-data backfill
Requires=seiche-storage-preflight.service
After=network-online.target postgresql.service seiche-storage-preflight.service
Wants=network-online.target postgresql.service
RequiresMountsFor=/var/lib/seiche /var/backups/seiche-market

[Service]
Type=oneshot
User=seiche
Group=seiche
WorkingDirectory=/home/seiche/app
EnvironmentFile=/etc/seiche/market.env
EnvironmentFile=-/etc/seiche/rbnz-access.env
EnvironmentFile=-/etc/seiche/bok-ecos.env
EnvironmentFile=-/etc/seiche/cfets-access.env
ExecStart=/home/seiche/app/backend/.venv/bin/seiche market-backfill
TimeoutStartSec=2h
# Backfill is throughput work, not request-path work. Keep one CPU available to
# it while giving the API and deploy health probes priority under contention.
CPUQuota=100%
CPUWeight=10
IOWeight=10
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/etc/seiche/cfets-approval.conf -/etc/seiche/cfets-licence-evidence.pdf
ReadWritePaths=/var/lib/seiche
UMask=0027
