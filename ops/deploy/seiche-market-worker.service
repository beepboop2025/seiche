[Unit]
Description=Seiche independent monetary-area collectors
After=network-online.target postgresql.service seiche-market-backfill.service
Wants=network-online.target postgresql.service
OnFailure=undertow-failure-alert@%n.service
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=seiche
Group=seiche
WorkingDirectory=/home/seiche/app
EnvironmentFile=/etc/seiche/market.env
EnvironmentFile=-/etc/seiche/rbnz-access.env
EnvironmentFile=-/etc/seiche/bok-ecos.env
EnvironmentFile=-/etc/seiche/cfets-access.env
ExecStart=/home/seiche/app/backend/.venv/bin/seiche market-worker --poll-seconds 30
Restart=always
RestartSec=15
WatchdogSec=180
TimeoutStartSec=60
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/etc/seiche/cfets-approval.conf -/etc/seiche/cfets-licence-evidence.pdf
ReadWritePaths=/var/lib/seiche
UMask=0027

[Install]
WantedBy=multi-user.target
