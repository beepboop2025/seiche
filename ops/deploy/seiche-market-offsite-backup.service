[Unit]
Description=Encrypt, upload, and restore-verify a Seiche market snapshot
Documentation=file:///home/seiche/app/ops/deploy/MARKET-BACKUPS.md
Requires=seiche-storage-preflight.service
After=network-online.target seiche-storage-preflight.service seiche-market-backup.service
Wants=network-online.target
RequiresMountsFor=/var/backups/seiche-market
AssertPathExists=/etc/seiche/offsite-backup.env
AssertPathExists=/etc/seiche/offsite-backup.passphrase
AssertPathExists=/root/.config/anchor/object-storage.env
AssertPathExists=/var/lib/seiche-deploy/deployed-sha
AssertFileIsExecutable=/etc/seiche/libexec/seiche-market-offsite-backup.sh
OnFailure=undertow-failure-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/root/.config/anchor/object-storage.env
EnvironmentFile=/etc/seiche/offsite-backup.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /etc/seiche/libexec/seiche-market-offsite-backup.sh
TimeoutStartSec=6h
TimeoutStopSec=15m
KillMode=control-group
OOMPolicy=stop
UMask=0077
CPUQuota=50%
CPUWeight=5
IOWeight=5
IOSchedulingClass=idle
Nice=15
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=0
TasksMax=64
LimitCORE=0

CacheDirectory=seiche-market-offsite-backup
CacheDirectoryMode=0700
StateDirectory=seiche-offsite-backup
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/seiche/app /var/backups/seiche-market /etc/seiche/offsite-backup.env /etc/seiche/offsite-backup.passphrase /root/.config/anchor/object-storage.env /var/lib/seiche-deploy/deployed-sha
ReadWritePaths=/var/cache/seiche-market-offsite-backup /var/lib/seiche-offsite-backup /run/lock
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
