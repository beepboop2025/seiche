[Unit]
Description=Gate and deploy the exact trusted Seiche main commit
After=network-online.target
Wants=network-online.target
OnFailure=undertow-failure-alert@%n.service

[Service]
Type=oneshot
Environment=SEICHE_CONTROL_ALLOWED_SIGNERS=/etc/seiche-release.allowed-signers
Environment=SEICHE_CONTROL_SIGNING_PRINCIPAL=beepboop2025@users.noreply.github.com
ExecStart=/usr/local/sbin/seiche-release-poll
TimeoutStartSec=3h
TimeoutStopSec=2min
KillMode=mixed
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/seiche-release.allowed-signers
