[Unit]
Description=Activate an exact controller-approved Seiche snapshot
After=postgresql.service
Wants=postgresql.service
OnFailure=undertow-failure-alert@%n.service

[Service]
Type=oneshot
User=seiche
Group=seiche
WorkingDirectory=/home/seiche/app/backend
EnvironmentFile=/etc/seiche/market.env
EnvironmentFile=/etc/seiche/release.env
ExecStart=/home/seiche/app/backend/.venv/bin/python -m seiche.release_promote
ExecStopPost=+/usr/bin/rm -f /run/seiche-release/promotion-request.json
TimeoutStartSec=300
UMask=0027

NoNewPrivileges=true
CapabilityBoundingSet=
MemoryMax=1G
TasksMax=64
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/home/seiche/app/backend/data
