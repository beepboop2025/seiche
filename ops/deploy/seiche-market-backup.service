[Unit]
Description=Commit a verified local Seiche market-data snapshot
Requires=seiche-storage-preflight.service
After=postgresql.service seiche-storage-preflight.service
Wants=postgresql.service
RequiresMountsFor=/var/lib/seiche /var/backups/seiche-market
OnFailure=undertow-failure-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/seiche/market.env
ExecStart=/usr/bin/flock --wait 300 /run/lock/seiche-market-backup.lock /usr/bin/bash /home/seiche/app/ops/deploy/seiche-market-backup.sh
TimeoutStartSec=2h
CPUQuota=50%
CPUWeight=5
IOWeight=5
Nice=15
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=0
TasksMax=64
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
# Preserve only the credential-transition capabilities across flock and bash.
AmbientCapabilities=CAP_SETGID CAP_SETUID
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/home/seiche/app /var/lib/seiche /var/lib/seiche-nbs /var/lib/seiche-deploy
ReadWritePaths=/var/backups/seiche-market /run/lock
