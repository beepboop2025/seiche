# Security headers on EVERY response — the LiquiLens house standard, tightened
# (payment/usb permissions, COOP, plus base-uri in the CSP). The CSP is a hard
# lockdown because this host serves JSON only — no HTML, no assets. Imported
# at site level below so preflight and the catch-all 404 carry them too, and
# it strips the Server header (defers to write time, so upstream's goes too).
(security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
    header X-Frame-Options "DENY"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    header Cross-Origin-Opener-Policy "same-origin"
    header -Server
}

# api.seiche.info — read-only public window + subscriber auth.
# Whitelisted: the live board, the (auth-gated) Time Machine, login, me.
# Everything else (ask/config/alerts, operator surface) stays 127.0.0.1-only.
# Access logging — one JSON log per site, rotated by Caddy itself.
# Added 2026-07-23: the box had NO access logs at all, so no property could
# answer "did anyone visit". Request URIs + status + remote IP only.
(accesslog) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
}

api.seiche.info {
    import accesslog
    import security_headers

    # Riptide's paper-only public record. The origin binds loopback on 8797;
    # stripping /riptide keeps its REST, OpenAPI and stateless MCP paths rooted
    # at / while the public discovery documents retain the product namespace.
    @riptide_root path /riptide
    handle @riptide_root {
        rewrite * /
        reverse_proxy 127.0.0.1:8797
    }
    handle_path /riptide/* {
        reverse_proxy 127.0.0.1:8797
    }

    # AnakE-Nyx external-factor feeds — static public-data mirror,
    # pulled hourly from the private repo; consumed by LiquiLens/DragonScope.
    handle_path /anake-nyx/feeds/* {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=600"
        header X-Content-Type-Options "nosniff"
        root * /opt/anake-nyx/feeds
        file_server
    }

    # Undertow MCP remote (agent tools; bearer-token subscriber tier
    # verified in-process against the bot entitlement state). Must sit
    # ABOVE the static /undertow/* mirror — handle blocks match in
    # source order. The site-wide OPTIONS preflight handler sits below
    # the mirror and never fires for this path, so answer it here.
    handle /undertow/mcp* {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE"
        header Access-Control-Allow-Headers "Authorization, Content-Type, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID"
        header Access-Control-Expose-Headers "X-MCP-Usage-Used, X-MCP-Usage-Limit, X-MCP-Usage-Remaining"
        header X-Content-Type-Options "nosniff"
        @mcp_opts method OPTIONS
        respond @mcp_opts 204
        reverse_proxy 127.0.0.1:8794
    }

    # Undertow x402 machine-payable feed (paid attested data; free
    # summary/manifest). Must sit ABOVE the static /undertow/* mirror —
    # handle blocks match in source order. Path passes intact.
    handle /undertow/x402/* {
        reverse_proxy 127.0.0.1:8791
    }

    # Undertow subscriber web backend (web desk login + entitled
    # packs). Must sit ABOVE the static /undertow/* mirror —
    # handle blocks match in source order.
    handle /undertow/desk/* {
        reverse_proxy 127.0.0.1:8792
    }

    # Undertow LIVE relay snapshots (undertow-liverelay.service writes
    # /var/lib/undertow-relay every ~1.5s; quotes.json + klines.json).
    # no-store: the mirror 10-minute cache header would defeat a live
    # snapshot. Must sit ABOVE the static /undertow/* mirror block —
    # handle blocks match in source order.
    handle_path /undertow/live/* {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        root * /var/lib/undertow-relay
        file_server
    }

    # Curated Undertow API discovery. The static mirror has no index file, so
    # the otherwise useful public pack surface answered 404 at its own root.
    # Keep this exact-path document above the wildcard mirror.
    @undertow_index path /undertow /undertow/
    handle @undertow_index {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300"
        header Content-Type "application/json"
        header X-Content-Type-Options "nosniff"
        respond `{"product":"Undertow","job":"market-level liquidity and position-sized exit cost","developer_guide":"https://liquilens-undertow.com/developers/","mcp":{"url":"https://api.seiche.info/undertow/mcp","transport":"streamable-http","authentication":"none for eight public tools","first_tool":"exit_cost"},"rest":{"free_summary":"/undertow/x402/summary","sealed_record":"/undertow/sealed_calls.json","public_packs":"/undertow/<pack>.json","machine_payable":"/undertow/x402/"},"disclaimer":"Research and market data, not investment advice."}` 200
    }

    # Undertow published packs — static public mirror (board + retail
    # packs only; refreshed by undertow-public-mirror.timer). Consumed by
    # the LiquiLens app's Undertow Retail layer.
    handle_path /undertow/* {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=600"
        header X-Content-Type-Options "nosniff"
        root * /opt/undertow-public
        file_server
    }

    # Palimpsest OSINT China receives exactly the signed, sanitized Nemesis
    # snapshot and its detached authentication tag. The private database,
    # dashboard, and API remain unreachable from the edge.
    @palimpsest_osint path /palimpsest/osint/osint-china.json /palimpsest/osint/osint-china.json.hmac-sha256
    handle @palimpsest_osint {
        header Access-Control-Allow-Origin "https://palimpsest.info"
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        uri strip_prefix /palimpsest/osint
        root * /var/lib/palimpsest-nemesis/public
        file_server
    }

    # Palimpsest MCP (censorship signals). This is its permanent home: a
    # dedicated mcp.palimpsest.info was considered and declined 2026-08-02,
    # since the only thing it bought was keeping the Palimpsest name out of a
    # seiche.info URL, and both hosts resolve to this same box anyway. Strip
    # the prefix and proxy.
    handle_path /palimpsest/mcp* {
        rewrite * /
        reverse_proxy 127.0.0.1:8793
    }

    # noisefloor MCP (is this number real, or is it noise? — six zero-dep
    # stats tools). Strip the prefix; the server answers on any path.
    # DO NOT DROP in rewrites: this block was lost in the 2026-07-30 Caddy
    # rewrite and every registry/Smithery listing 404'd until restored
    # 2026-08-02. The site preflight handler below never fires for handled
    # paths, so OPTIONS is answered here, undertow-mcp style.
    handle_path /noisefloor/* {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Headers "Authorization, Content-Type, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID"
        header Access-Control-Expose-Headers "Mcp-Session-Id"
        header X-Content-Type-Options "nosniff"
        @nf_opts method OPTIONS
        respond @nf_opts 204
        reverse_proxy 127.0.0.1:8795
    }

    encode zstd gzip

    # The edge is an allow-list: anything not named here gets "not here" from
    # the handle block at the bottom, never the backend. A route added in
    # api.py is invisible from outside until it is added here too, which is
    # how the citability endpoints shipped, deployed green, and still 404'd.
    #
    # /api/series/* covers the CSV export, its catalog, and the JSON twin.
    # Both export routes enforce the same licence allow-list in
    # methodology.csv_restriction, so opening the path here does not open the
    # licensed series. (require_board is NOT a guard: it is a deliberate
    # no-op in production because Seiche is free — the licence gate lives in
    # the app, where it deploys through the normal chain.)
    #
    # The signed world-model delivery is deliberately outside @public. It is
    # one bearer-gated machine-to-machine path and returns opaque publisher
    # bytes; the Railway consumer, not Seiche, verifies Ed25519 authority.
    @world_model_delivery {
        method GET
        path /api/internal/v1/world-model/us-usd-funding-core-v2
    }
    handle @world_model_delivery {
        header Cache-Control "no-store, no-transform"
        header X-Content-Type-Options "nosniff"
        reverse_proxy 127.0.0.1:8787
    }
    @world_model_delivery_non_get path /api/internal/v1/world-model/us-usd-funding-core-v2
    handle @world_model_delivery_non_get {
        header Cache-Control "no-store, no-transform"
        respond "not here" 404
    }
    @public {
        method GET HEAD
        path /api /api/openapi.json /api/health /api/overview /api/public /api/gauge /api/oil-funding /api/estuary /api/wrecks /api/asof/* /api/v2/* /api/me /api/dispatch/* /api/alerts/prefs /api/notary /api/notary/proof/* /api/attest/* /api/badge/* /api/series/* /api/subscribe
    }
    # The Week Ahead list. GET is in @public above (the front door asks whether
    # the list is wired up before it draws a form); POST needs its own name here
    # because @public is GET/HEAD only. Without both, the subscribe field would
    # deploy green and 404 at the edge, which is this file's oldest bug.
    #
    # This is not an auth route. It is grouped with @login purely because that
    # is where POST lives; the handler takes no token and gates no content.
    @login {
        method POST
        path /api/auth/login /api/alerts/prefs /api/subscribe
    }
    handle @public {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Headers "Authorization, Content-Type"
        header X-Content-Type-Options "nosniff"
        reverse_proxy 127.0.0.1:8787
    }
    handle @login {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Headers "Authorization, Content-Type"
        reverse_proxy 127.0.0.1:8787
    }
    @preflight method OPTIONS
    handle @preflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Authorization, Content-Type, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID, X-Seiche-Signature, X-PAYMENT"
        respond 204
    }
    @mcp {
        path /mcp /mcp/usage /api/provision
    }
    handle @mcp {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Headers "Authorization, Content-Type, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID, X-Seiche-Signature, X-PAYMENT"
        header Access-Control-Expose-Headers "Mcp-Session-Id, X-MCP-Usage-Used, X-MCP-Usage-Limit, X-MCP-Usage-Remaining, X-PAYMENT-RESPONSE"
        header X-Content-Type-Options "nosniff"
        reverse_proxy 127.0.0.1:8787
    }
    # Glama MCP-directory ownership proof — the connector claim for
    # io.github.beepboop2025/seiche checks this exact path on the
    # server's domain. Static, public by design; the email is the
    # project account, not a person's private address.
    handle /.well-known/glama.json {
        header Content-Type "application/json"
        header Cache-Control "public, max-age=3600"
        respond `{"$schema":"https://glama.ai/mcp/schemas/connector.json","maintainers":[{"email":"mrinallovesbhature@gmail.com"}]}` 200
    }

    handle {
        respond "not here" 404
    }
}

# groundcheck.seiche.info — public fact-check engine + x402 machine-payable /check.
# The engine has no operator surface; every endpoint is public by design.
groundcheck.seiche.info {
    import accesslog
    @preflight method OPTIONS
    handle @preflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, X-PAYMENT, PAYMENT-SIGNATURE"
        respond 204
    }
    # Glama MCP-directory ownership proof — the connector claim for
    # io.github.beepboop2025/groundcheck checks this exact path on the
    # server's domain. Static, public by design; the email is the
    # project account, not a person's private address.
    handle /.well-known/glama.json {
        header Content-Type "application/json"
        header Cache-Control "public, max-age=3600"
        respond `{"$schema":"https://glama.ai/mcp/schemas/connector.json","maintainers":[{"email":"mrinallovesbhature@gmail.com"}]}` 200
    }

    handle {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Headers "Content-Type, X-PAYMENT, PAYMENT-SIGNATURE"
        header Access-Control-Expose-Headers "X-PAYMENT-RESPONSE, PAYMENT-RESPONSE, PAYMENT-REQUIRED, X-Groundcheck-Free-Remaining"
        header X-Content-Type-Options "nosniff"
        reverse_proxy 127.0.0.1:8723
    }
}

# breach.seiche.info — read-only breach-intelligence MCP (public defensive tool).
breach.seiche.info {
    import accesslog
    # Glama MCP-directory ownership proof — the same claim file the
    # api.seiche.info and groundcheck vhosts serve; the email is the project
    # account, not a person's private address.
    handle /.well-known/glama.json {
        header Content-Type "application/json"
        header Cache-Control "public, max-age=3600"
        respond `{"$schema":"https://glama.ai/mcp/schemas/connector.json","maintainers":[{"email":"mrinallovesbhature@gmail.com"}]}` 200
    }
    handle {
        reverse_proxy 127.0.0.1:8790 {
            header_up Host 127.0.0.1:8790
        }
    }
}
