FROM node:22-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:0.12.10 AS uv
FROM rocker/r-ver:latest
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates openssh-client tini \
    && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
RUN uv python install 3.10 3.11 3.12 3.13 3.14 \
    && uv venv --seed --python 3.12 /opt/controller \
    && /opt/controller/bin/pip install --no-cache-dir PyYAML==6.0.3
COPY . /app
WORKDIR /app
ARG RAILWAY_GIT_COMMIT_SHA
# Reproducibility jobs require git archive and the exact source commit timestamp.
RUN printf '%s\n' "$RAILWAY_GIT_COMMIT_SHA" | grep -Eq '^[0-9a-f]{40}$' \
    && git init \
    && git remote add origin https://github.com/beepboop2025/seiche.git \
    && git fetch origin "+refs/heads/*:refs/remotes/origin/*" "+refs/tags/*:refs/tags/*" \
    && git fetch origin "$RAILWAY_GIT_COMMIT_SHA" \
    && git reset --mixed FETCH_HEAD \
    && git diff --exit-code HEAD
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["timeout", "--signal=TERM", "--kill-after=30", "3600", "/opt/controller/bin/python", "ops/railway-automation/distribution.py"]
