FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS gate-build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Pin the Debian package universe as well as the base image. The full deploy
# contract suite invokes Git, ssh-keygen, systemd-analyze, setpriv/flock, ps and
# curl; python:slim deliberately omits those host-contract tools.
RUN printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20250929T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20250929T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && find /etc/apt/sources.list.d -mindepth 1 -maxdepth 1 -type f -delete \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client procps systemd util-linux \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete

ARG CADDY_VERSION=2.11.4
ARG CADDY_SHA512=8220d1f013b6f27510247b2360c9e0ca9f018feebd82515f07635318b34ff9777ccc8fd0b6e6f2486ce3a33fe389fbb7db12d05baa474f4587509fb4f5ebf1c9
RUN test "$(uname -m)" = x86_64 \
    && curl --fail --silent --show-error --location \
      --proto '=https' --tlsv1.2 \
      "https://github.com/caddyserver/caddy/releases/download/v${CADDY_VERSION}/caddy_${CADDY_VERSION}_linux_amd64.tar.gz" \
      --output /tmp/caddy.tar.gz \
    && printf '%s  %s\n' "$CADDY_SHA512" /tmp/caddy.tar.gz \
      | sha512sum --check --strict \
    && tar -xzf /tmp/caddy.tar.gz -C /usr/local/bin caddy \
    && chmod 0755 /usr/local/bin/caddy

WORKDIR /build
ADD source.tar /build/
RUN python -m pip install -q "./backend[dev,collectors]" \
    && python -m pip install --disable-pip-version-check --only-binary=:all: \
      --require-hashes -r ops/requirements-social-cards.txt

FROM gate-build AS gate-runtime

# The archive remains the canonical byte inventory. A one-commit Git bundle
# supplies the matching immutable commit object required by Seiche's runtime
# release-identity check; the runner independently binds HEAD/tree/archive.
WORKDIR /gate
COPY source.tar source.bundle /gate/
COPY gate-request.json /gate/request.json
COPY run-gate.py /gate/run-gate.py
RUN git clone --quiet /gate/source.bundle /workspace \
    && git config --system --add safe.directory /workspace \
    && chmod 0555 /gate \
    && chmod 0444 /gate/source.tar /gate/source.bundle \
      /gate/request.json /gate/run-gate.py \
    && chmod -R a-w /workspace \
    && { test -e /usr/bin/python3 || ln -s /usr/local/bin/python /usr/bin/python3; }

WORKDIR /workspace
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["python", "/gate/run-gate.py"]
