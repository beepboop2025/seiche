FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS snapshot-build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20250814T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20250814T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && find /etc/apt/sources.list.d -mindepth 1 -maxdepth 1 -type f -delete \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete

WORKDIR /build
ADD source.tar /build/
RUN python -m pip install -q "./backend[collectors]"

FROM snapshot-build AS snapshot-runtime

WORKDIR /workspace
COPY source.tar /gate/source.tar
ADD source.tar /workspace/
COPY snapshot-request.json /gate/request.json
COPY run-snapshot.py /gate/run-snapshot.py
RUN install -d -o 65532 -g 65532 -m 0700 /result \
    && chmod 0555 /gate \
    && chmod 0444 /gate/source.tar /gate/request.json /gate/run-snapshot.py \
    && chmod -R a-w /workspace

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["python", "/gate/run-snapshot.py"]
