{
  "name": "seiche-discovery",
  "main": "discovery-worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "https://seiche.info/sitemap.xml*", "zone_name": "seiche.info" },
    { "pattern": "https://seiche.info/robots.txt*", "zone_name": "seiche.info" },
    { "pattern": "https://seiche.info/llms.txt*", "zone_name": "seiche.info" },
    { "pattern": "https://seiche.info/.well-known/ai-catalog.json*", "zone_name": "seiche.info" }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
