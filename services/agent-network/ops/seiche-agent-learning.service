[Unit]
Description=Separately enrolled financial agent learning service
After=network-online.target

[Service]
Type=simple
User=seiche-network
Group=seiche-network
WorkingDirectory=/opt/seiche-agent-network/current-hub
Environment=PYTHONPATH=/opt/seiche-agent-network/current-hub/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/seiche-agent-network/venv/bin/python -m financial_evidence.learning --store /var/lib/seiche-agent-network/learning serve --host 127.0.0.1 --port 18797
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seiche-agent-network/learning
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M

[Install]
WantedBy=multi-user.target
