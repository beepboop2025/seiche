[Unit]
Description=Wake signed commerce and free public economic evidence
After=network-online.target

[Service]
Type=simple
User=seiche-network
Group=seiche-network
WorkingDirectory=/opt/seiche-agent-network/current-wake
Environment=PYTHONPATH=/opt/seiche-agent-network/current-wake/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/seiche-agent-network/venv/bin/python -m wake.cli serve --config /var/lib/seiche-agent-network/wake/config.json --host 127.0.0.1 --port 18798
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seiche-agent-network/wake
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M

[Install]
WantedBy=multi-user.target
