[Unit]
Description=Agent economic activity evidence API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=seiche-agent-activity
Group=seiche-agent-activity
WorkingDirectory=/opt/seiche-agent-activity/current
EnvironmentFile=/etc/seiche-agent-activity/service.env
Environment=PYTHONPATH=/opt/seiche-agent-activity/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ACTIVITY_PUBLIC_PREFIX=/activity/
ExecStart=/opt/seiche-agent-activity/current/.venv/bin/python -m agent_activity.cli --state /var/lib/seiche-agent-activity serve --port 18804 --operator-file /etc/seiche-agent-activity/operator.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seiche-agent-activity
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
