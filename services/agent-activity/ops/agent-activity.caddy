handle /agents/activity {
	header >Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	rewrite * /
	reverse_proxy 127.0.0.1:18804
}
handle_path /agents/activity/* {
	header >Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	request_body {
		max_size 64KiB
	}
	reverse_proxy 127.0.0.1:18804
}
